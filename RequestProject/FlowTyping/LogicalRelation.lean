module
public import RequestProject.FlowTyping.Semantics

/-!
# The logical relation for `λL` (Appendix D.2)

* `LR.W A`: well-typed closed terms of type `A` (`W⟦A⟧`, as a predicate on each component).
* `LR.V A`, `LR.T A`: the logical relations `V⟦A⟧ ⊆ Value × Value` and `T⟦A⟧ ⊆ Term × Term`,
  by recursion on `A`.
* `LR.C Γ`: the interpretation `C⟦Γ⟧` of a context, on closing substitutions.
* `LR.Sem Γ t₁ t₂ A`: `Γ ⊨ t₁ ≈ t₂ : A`.

Results: Lemma D.3 (`LR.V.wellTyped`, `LR.T.wellTyped`), Lemma D.4 (`LR.sem_closed_iff`),
Theorem D.5 (the fundamental theorem, `LR.fundamental`), Lemma D.6 (symmetry) and Lemma D.7
(transitivity), Lemma D.9 (`LR.sem_eval`), and Proposition 7.1 (type safety, `type_safety`).

The appendix does not specify `V⟦α⟧` for a type variable `α`; we take it to be empty (as for
`0`).  The fundamental theorem holds for any choice, since no rule introduces or eliminates a
type variable.
-/

@[expose] public section

namespace FlowTyping

namespace LR

/-- `W⟦A⟧`: closed terms of type `A`. -/
def W (A : Ty) (t : Term 0) : Prop := Lin (LCtx.empty 0) t A

/-- The term relation generated by a value relation: both terms are well typed and evaluate
to related values. -/
def TT (R : Term 0 → Term 0 → Prop) (A : Ty) (t₁ t₂ : Term 0) : Prop :=
  W A t₁ ∧ W A t₂ ∧ ∃ v₁ v₂, Eval t₁ v₁ ∧ Eval t₂ v₂ ∧ R v₁ v₂

/-- The value relation `V⟦A⟧`. -/
def V : Ty → Term 0 → Term 0 → Prop
  | .tvar _ => fun _ _ => False
  | .lolli A B => fun v₁ v₂ =>
      W (.lolli A B) v₁ ∧ W (.lolli A B) v₂ ∧
      ∃ t₁ t₂ : Term 1, v₁ = .lam A t₁ ∧ v₂ = .lam A t₂ ∧
        ∀ w₁ w₂, V A w₁ w₂ → TT (V B) B (t₁.subst fun _ => w₁) (t₂.subst fun _ => w₂)
  | .tensor A B => fun v₁ v₂ =>
      ∃ a₁ b₁ a₂ b₂, v₁ = .pair a₁ b₁ ∧ v₂ = .pair a₂ b₂ ∧ V A a₁ a₂ ∧ V B b₁ b₂
  | .one => fun v₁ v₂ => v₁ = .unit ∧ v₂ = .unit
  | .plus A B => fun v₁ v₂ =>
      (∃ a₁ a₂, v₁ = .inl A B a₁ ∧ v₂ = .inl A B a₂ ∧ V A a₁ a₂) ∨
      (∃ b₁ b₂, v₁ = .inr A B b₁ ∧ v₂ = .inr A B b₂ ∧ V B b₁ b₂)
  | .zero => fun _ _ => False
  | .with A B => fun v₁ v₂ =>
      ∃ a₁ b₁ a₂ b₂, v₁ = .withPair a₁ b₁ ∧ v₂ = .withPair a₂ b₂ ∧
        TT (V A) A a₁ a₂ ∧ TT (V B) B b₁ b₂
  | .top => fun v₁ v₂ =>
      W .top v₁ ∧ W .top v₂ ∧
      ∃ w₁ w₂, IsValue w₁ ∧ IsValue w₂ ∧ v₁ = .trueI w₁ ∧ v₂ = .trueI w₂
  | .bang A => fun v₁ v₂ => ∃ a₁ a₂, v₁ = a₁.bang ∧ v₂ = a₂.bang ∧ TT (V A) A a₁ a₂

/-- The term relation `T⟦A⟧`. -/
def T (A : Ty) : Term 0 → Term 0 → Prop := TT (V A) A

/-- `C⟦Γ⟧`: pointwise related closing substitutions. -/
def C {n : ℕ} (Γ : LCtx n) (γ₁ γ₂ : Fin n → Term 0) : Prop :=
  ∀ i A, Γ i = some A → V A (γ₁ i) (γ₂ i)

/-- `Γ ⊨ t₁ ≈ t₂ : A`. -/
def Sem {n : ℕ} (Γ : LCtx n) (t₁ t₂ : Term n) (A : Ty) : Prop :=
  ∀ γ₁ γ₂, C Γ γ₁ γ₂ → T A (t₁.subst γ₁) (t₂.subst γ₂)

/-! ## Basic properties -/

lemma V.isValue : ∀ (A : Ty) {v₁ v₂ : Term 0}, V A v₁ v₂ → IsValue v₁ ∧ IsValue v₂
  | .tvar _, _, _, h => h.elim
  | .lolli _ _, _, _, ⟨_, _, _, _, e₁, e₂, _⟩ => by subst e₁ e₂; exact ⟨.lam _ _, .lam _ _⟩
  | .tensor A B, _, _, ⟨_, _, _, _, e₁, e₂, ha, hb⟩ => by
    subst e₁ e₂
    exact ⟨.pair (V.isValue A ha).1 (V.isValue B hb).1, .pair (V.isValue A ha).2 (V.isValue B hb).2⟩
  | .one, _, _, ⟨e₁, e₂⟩ => by subst e₁ e₂; exact ⟨.unit, .unit⟩
  | .plus A B, _, _, h => by
    rcases h with ⟨_, _, e₁, e₂, ha⟩ | ⟨_, _, e₁, e₂, hb⟩
    · subst e₁ e₂; exact ⟨.inl _ _ (V.isValue A ha).1, .inl _ _ (V.isValue A ha).2⟩
    · subst e₁ e₂; exact ⟨.inr _ _ (V.isValue B hb).1, .inr _ _ (V.isValue B hb).2⟩
  | .zero, _, _, h => h.elim
  | .with _ _, _, _, ⟨_, _, _, _, e₁, e₂, _⟩ => by
    subst e₁ e₂; exact ⟨.withPair _ _, .withPair _ _⟩
  | .top, _, _, ⟨_, _, _, _, h₁, h₂, e₁, e₂⟩ => by subst e₁ e₂; exact ⟨.trueI h₁, .trueI h₂⟩
  | .bang _, _, _, ⟨_, _, e₁, e₂, _⟩ => by subst e₁ e₂; exact ⟨.bang _, .bang _⟩

lemma split_empty : (LCtx.empty 0).Split (LCtx.empty 0) (LCtx.empty 0) :=
  fun _ => Or.inl ⟨rfl, rfl⟩

lemma bang_wellTyped {a : Term 0} {A : Ty} (h : W A a) : W (.bang A) a.bang := by
  refine Lin.promote (Γs := Fin.elim0) (As := Fin.elim0) (fun i => Or.inl ⟨rfl, fun j => j.elim0⟩)
    (fun j => j.elim0) ?_
  have : (fun j : Fin 0 => some (Ty.bang (Fin.elim0 j))) = LCtx.empty 0 :=
    funext fun j => j.elim0
  rw [this]; exact h

/-- **Lemma D.3** (values). `V⟦A⟧ ⊆ W⟦A⟧`. -/
lemma V.wellTyped : ∀ (A : Ty) {v₁ v₂ : Term 0}, V A v₁ v₂ → W A v₁ ∧ W A v₂
  | .tvar _, _, _, h => h.elim
  | .lolli _ _, _, _, ⟨h₁, h₂, _⟩ => ⟨h₁, h₂⟩
  | .tensor A B, _, _, ⟨_, _, _, _, e₁, e₂, ha, hb⟩ => by
    subst e₁ e₂
    exact ⟨.pair split_empty (V.wellTyped A ha).1 (V.wellTyped B hb).1,
      .pair split_empty (V.wellTyped A ha).2 (V.wellTyped B hb).2⟩
  | .one, _, _, ⟨e₁, e₂⟩ => by subst e₁ e₂; exact ⟨.unit, .unit⟩
  | .plus A B, _, _, h => by
    rcases h with ⟨_, _, e₁, e₂, ha⟩ | ⟨_, _, e₁, e₂, hb⟩
    · subst e₁ e₂; exact ⟨.inl (V.wellTyped A ha).1, .inl (V.wellTyped A ha).2⟩
    · subst e₁ e₂; exact ⟨.inr (V.wellTyped B hb).1, .inr (V.wellTyped B hb).2⟩
  | .zero, _, _, h => h.elim
  | .with _ _, _, _, ⟨_, _, _, _, e₁, e₂, ha, hb⟩ => by
    subst e₁ e₂; exact ⟨.withPair ha.1 hb.1, .withPair ha.2.1 hb.2.1⟩
  | .top, _, _, ⟨h₁, h₂, _⟩ => ⟨h₁, h₂⟩
  | .bang _, _, _, ⟨_, _, e₁, e₂, h⟩ => by
    subst e₁ e₂; exact ⟨bang_wellTyped h.1, bang_wellTyped h.2.1⟩

/-- **Lemma D.3** (terms). `T⟦A⟧ ⊆ W⟦A⟧`. -/
lemma T.wellTyped {A : Ty} {t₁ t₂ : Term 0} (h : T A t₁ t₂) : W A t₁ ∧ W A t₂ := ⟨h.1, h.2.1⟩

/-- Related values are related terms. -/
lemma V.toT {A : Ty} {v₁ v₂ : Term 0} (h : V A v₁ v₂) : T A v₁ v₂ :=
  ⟨(V.wellTyped A h).1, (V.wellTyped A h).2, v₁, v₂, (V.isValue A h).1.eval_self,
    (V.isValue A h).2.eval_self, h⟩

/-- **Lemma D.4.** `⊨ t₁ ≈ t₂ : A` iff `(t₁, t₂) ∈ T⟦A⟧`. -/
theorem sem_closed_iff (t₁ t₂ : Term 0) (A : Ty) :
    Sem (LCtx.empty 0) t₁ t₂ A ↔ T A t₁ t₂ := by
  constructor
  · intro h
    have := h Fin.elim0 Fin.elim0 (fun i => i.elim0)
    simpa using this
  · intro h γ₁ γ₂ _
    simpa using h

/-! ## Symmetry and transitivity (Lemmas D.6 and D.7) -/

lemma TT.symm {R R' : Term 0 → Term 0 → Prop} {A : Ty} (hR : ∀ v₁ v₂, R v₁ v₂ → R' v₂ v₁)
    {t₁ t₂ : Term 0} (h : TT R A t₁ t₂) : TT R' A t₂ t₁ := by
  obtain ⟨h₁, h₂, v₁, v₂, e₁, e₂, hv⟩ := h
  exact ⟨h₂, h₁, v₂, v₁, e₂, e₁, hR _ _ hv⟩

/-- **Lemma D.6 (symmetry)** for `V⟦-⟧`. -/
theorem V.symm : ∀ (A : Ty) {v₁ v₂ : Term 0}, V A v₁ v₂ → V A v₂ v₁
  | .tvar _, _, _, h => h.elim
  | .lolli A B, _, _, ⟨h₁, h₂, t₁, t₂, e₁, e₂, h⟩ =>
    ⟨h₂, h₁, t₂, t₁, e₂, e₁, fun w₁ w₂ hw =>
      TT.symm (fun _ _ => V.symm B) (h w₂ w₁ (V.symm A hw))⟩
  | .tensor A B, _, _, ⟨a₁, b₁, a₂, b₂, e₁, e₂, ha, hb⟩ =>
    ⟨a₂, b₂, a₁, b₁, e₂, e₁, V.symm A ha, V.symm B hb⟩
  | .one, _, _, ⟨e₁, e₂⟩ => ⟨e₂, e₁⟩
  | .plus A B, _, _, h => by
    rcases h with ⟨a₁, a₂, e₁, e₂, ha⟩ | ⟨b₁, b₂, e₁, e₂, hb⟩
    · exact Or.inl ⟨a₂, a₁, e₂, e₁, V.symm A ha⟩
    · exact Or.inr ⟨b₂, b₁, e₂, e₁, V.symm B hb⟩
  | .zero, _, _, h => h.elim
  | .with A B, _, _, ⟨a₁, b₁, a₂, b₂, e₁, e₂, ha, hb⟩ =>
    ⟨a₂, b₂, a₁, b₁, e₂, e₁, TT.symm (fun _ _ => V.symm A) ha, TT.symm (fun _ _ => V.symm B) hb⟩
  | .top, _, _, ⟨h₁, h₂, w₁, w₂, hw₁, hw₂, e₁, e₂⟩ => ⟨h₂, h₁, w₂, w₁, hw₂, hw₁, e₂, e₁⟩
  | .bang A, _, _, ⟨a₁, a₂, e₁, e₂, h⟩ => ⟨a₂, a₁, e₂, e₁, TT.symm (fun _ _ => V.symm A) h⟩

/-- **Lemma D.6 (symmetry)** for `T⟦-⟧`. -/
theorem T.symm {A : Ty} {t₁ t₂ : Term 0} (h : T A t₁ t₂) : T A t₂ t₁ :=
  TT.symm (fun _ _ => V.symm A) h

lemma TT.trans {R : Term 0 → Term 0 → Prop} {A : Ty}
    (hR : ∀ v₁ v₂ v₃, R v₁ v₂ → R v₂ v₃ → R v₁ v₃)
    {t₁ t₂ t₃ : Term 0} (h : TT R A t₁ t₂) (h' : TT R A t₂ t₃) : TT R A t₁ t₃ := by
  obtain ⟨h₁, _, v₁, v₂, e₁, e₂, hv⟩ := h
  obtain ⟨_, h₃, v₂', v₃, e₂', e₃, hv'⟩ := h'
  cases e₂.deterministic e₂'
  exact ⟨h₁, h₃, v₁, v₃, e₁, e₃, hR _ _ _ hv hv'⟩

/-- **Lemma D.7 (transitivity)** for `V⟦-⟧`. -/
theorem V.trans : ∀ (A : Ty) {v₁ v₂ v₃ : Term 0}, V A v₁ v₂ → V A v₂ v₃ → V A v₁ v₃
  | .tvar _, _, _, _, h, _ => h.elim
  | .lolli A B, _, _, _, ⟨h₁, _, t₁, t₂, e₁, e₂, h⟩, ⟨_, h₃, t₂', t₃, e₂', e₃, h'⟩ => by
    subst e₁ e₂ e₃
    simp only [Term.lam.injEq, true_and] at e₂'
    subst e₂'
    refine ⟨h₁, h₃, t₁, t₃, rfl, rfl, fun w₁ w₃ hw => ?_⟩
    have hw₃ : V A w₃ w₃ := V.trans A (V.symm A hw) hw
    exact TT.trans (R := V B) (fun _ _ _ h₁ h₂ => V.trans B h₁ h₂) (h w₁ w₃ hw) (h' w₃ w₃ hw₃)
  | .tensor A B, _, _, _, ⟨a₁, b₁, a₂, b₂, e₁, e₂, ha, hb⟩,
      ⟨a₂', b₂', a₃, b₃, e₂', e₃, ha', hb'⟩ => by
    subst e₁ e₂ e₃
    simp only [Term.pair.injEq] at e₂'
    obtain ⟨rfl, rfl⟩ := e₂'
    exact ⟨a₁, b₁, a₃, b₃, rfl, rfl, V.trans A ha ha', V.trans B hb hb'⟩
  | .one, _, _, _, ⟨e₁, _⟩, ⟨_, e₃⟩ => ⟨e₁, e₃⟩
  | .plus A B, _, _, _, h, h' => by
    rcases h with ⟨a₁, a₂, e₁, e₂, ha⟩ | ⟨b₁, b₂, e₁, e₂, hb⟩ <;>
    rcases h' with ⟨a₂', a₃, e₂', e₃, ha'⟩ | ⟨b₂', b₃, e₂', e₃, hb'⟩ <;>
    subst e₁ e₂ e₃ <;> simp only [Term.inl.injEq, Term.inr.injEq, reduceCtorEq] at e₂'
    · obtain ⟨-, -, rfl⟩ := e₂'
      exact Or.inl ⟨a₁, a₃, rfl, rfl, V.trans A ha ha'⟩
    · obtain ⟨-, -, rfl⟩ := e₂'
      exact Or.inr ⟨b₁, b₃, rfl, rfl, V.trans B hb hb'⟩
  | .zero, _, _, _, h, _ => h.elim
  | .with A B, _, _, _, ⟨a₁, b₁, a₂, b₂, e₁, e₂, ha, hb⟩,
      ⟨a₂', b₂', a₃, b₃, e₂', e₃, ha', hb'⟩ => by
    subst e₁ e₂ e₃
    simp only [Term.withPair.injEq] at e₂'
    obtain ⟨rfl, rfl⟩ := e₂'
    exact ⟨a₁, b₁, a₃, b₃, rfl, rfl, TT.trans (R := V A) (fun _ _ _ h₁ h₂ => V.trans A h₁ h₂) ha ha',
      TT.trans (R := V B) (fun _ _ _ h₁ h₂ => V.trans B h₁ h₂) hb hb'⟩
  | .top, _, _, _, ⟨h₁, _, w₁, _, hw₁, _, e₁, _⟩, ⟨_, h₃, _, w₃, _, hw₃, _, e₃⟩ =>
    ⟨h₁, h₃, w₁, w₃, hw₁, hw₃, e₁, e₃⟩
  | .bang A, _, _, _, ⟨a₁, a₂, e₁, e₂, h⟩, ⟨a₂', a₃, e₂', e₃, h'⟩ => by
    subst e₁ e₂ e₃
    cases Term.bang_inj e₂'
    exact ⟨a₁, a₃, rfl, rfl, TT.trans (R := V A) (fun _ _ _ h₁ h₂ => V.trans A h₁ h₂) h h'⟩

/-- **Lemma D.7 (transitivity)** for `T⟦-⟧`. -/
theorem T.trans {A : Ty} {t₁ t₂ t₃ : Term 0} (h : T A t₁ t₂) (h' : T A t₂ t₃) : T A t₁ t₃ :=
  TT.trans (R := V A) (fun _ _ _ h₁ h₂ => V.trans A h₁ h₂) h h'

/-- **Lemma D.6 (symmetry)** for `C⟦-⟧`. -/
theorem C.symm {n : ℕ} {Γ : LCtx n} {γ₁ γ₂ : Fin n → Term 0} (h : C Γ γ₁ γ₂) : C Γ γ₂ γ₁ :=
  fun i A hi => V.symm A (h i A hi)

/-- **Lemma D.7 (transitivity)** for `C⟦-⟧`. -/
theorem C.trans {n : ℕ} {Γ : LCtx n} {γ₁ γ₂ γ₃ : Fin n → Term 0} (h : C Γ γ₁ γ₂)
    (h' : C Γ γ₂ γ₃) : C Γ γ₁ γ₃ :=
  fun i A hi => V.trans A (h i A hi) (h' i A hi)

/-- **Lemma D.6.** `Γ ⊨ - ≈ - : A` is symmetric. -/
theorem Sem.symm {n : ℕ} {Γ : LCtx n} {t₁ t₂ : Term n} {A : Ty} (h : Sem Γ t₁ t₂ A) :
    Sem Γ t₂ t₁ A :=
  fun γ₁ γ₂ hγ => T.symm (h γ₂ γ₁ hγ.symm)

/-- **Lemma D.7.** `Γ ⊨ - ≈ - : A` is transitive. -/
theorem Sem.trans {n : ℕ} {Γ : LCtx n} {t₁ t₂ t₃ : Term n} {A : Ty} (h : Sem Γ t₁ t₂ A)
    (h' : Sem Γ t₂ t₃ A) : Sem Γ t₁ t₃ A :=
  fun γ₁ γ₃ hγ => T.trans (h γ₁ γ₃ hγ) (h' γ₃ γ₃ (hγ.symm.trans hγ))

end LR

end FlowTyping
