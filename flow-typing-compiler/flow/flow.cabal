cabal-version: 3.0
name: flow
version: 0.1.0.0
license: NONE
author: Sky Wilshaw
maintainer: sky.wilshaw@nottingham.ac.uk
build-type: Simple

common warnings
  ghc-options:
    -Wall
    -Wno-unused-imports

executable flow
  import: warnings
  main-is: Main.hs
  other-modules:
    Examples
    FlowPrelude

  default-extensions:
    ImportQualifiedPost
    LinearTypes
    NoImplicitPrelude

  build-depends:
    base >=4.16,
    linear-base >=0.8,

  default-language: Haskell2010
